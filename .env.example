# Outlook MCP - Environment Configuration
# =========================================
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and will not be committed
#
# Get these values from:
# https://entra.microsoft.com > Identity > Applications > App registrations

# Azure AD App Registration
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=

# Optional: Custom download path for email attachments
# If not set, defaults to: ~/Downloads/outlook_attachments
# OUTLOOK_DOWNLOAD_PATH=C:\Users\YourName\Documents\Outlook_Attachments

# Optional: path to the server configuration file (transport, bind host/port).
# Defaults to outlook_mcp.toml in the project root; see outlook_mcp.toml.example
# OUTLOOK_MCP_CONFIG=/etc/outlook_mcp/outlook_mcp.toml

# Notes:
# - OUTLOOK_TENANT_ID can be "common" for multi-tenant apps
# - Never commit the actual .env file with real credentials
# - Run '. .\setup-env.ps1' to load these variables into your session
# - The three OUTLOOK_CLIENT_ID / _SECRET / _TENANT_ID values are used only by
#   the stdio transport and by outlook_mcp_auth.py. In HTTP mode the server
#   reads them from the X-Outlook-Client-Id / X-Outlook-Client-Secret /
#   X-Outlook-Tenant-Id request headers instead.
